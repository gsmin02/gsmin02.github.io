---
import type { CollectionEntry } from 'astro:content';
import Badge from './ui/Badge.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const fmt = (d: Date) =>
  `${d.getFullYear()}. ${String(d.getMonth() + 1).padStart(2, '0')}. ${String(d.getDate()).padStart(2, '0')}`;
---

{
  posts.length === 0 ? (
    <p class="py-12 text-sm text-muted-foreground">아직 글이 없습니다.</p>
  ) : (
    <div class="flex flex-col">
      {posts.map((post, i) => (
        <article
          class:list={['py-8', i < posts.length - 1 && 'border-b border-border']}
        >
          <div class="flex items-center gap-3">
            <time class="text-xs text-muted-foreground-subtle" datetime={post.data.date.toISOString()}>
              {fmt(post.data.date)}
            </time>
            <Badge variant="secondary">{post.data.tag}</Badge>
          </div>
          <h2 class="mt-2 text-2xl font-bold">
            <a href={`/blog/${post.id}`} class="hover:text-primary">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-2 text-sm text-muted-foreground">{post.data.summary}</p>
        </article>
      ))}
    </div>
  )
}
