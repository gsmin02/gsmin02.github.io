---
import type { NavGroup, NavKey } from '../lib/nav';
import { chevronDown, chevronRight, moon, sun } from './icons';
import NavItems from './NavItems.astro';

interface Props {
  active: NavKey;
  activeItem?: string;
  groups: NavGroup[];
}
const { active, activeItem, groups } = Astro.props;
---

<div data-mobile-nav class="sticky top-0 z-20 md:hidden">
  <div
    class="flex h-14 items-center justify-between border-b border-sidebar-border bg-sidebar px-4"
  >
    <a href="/" class="text-sm font-bold text-sidebar-foreground">gsmin02</a>
    <div class="flex items-center gap-1">
      <button
        type="button"
        data-theme-toggle
        aria-label="테마 전환"
        class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground"
      >
        <span class="dark:hidden" set:html={sun} />
        <span class="hidden dark:block" set:html={moon} />
      </button>
      <button
        type="button"
        data-mobile-trigger
        aria-expanded="false"
        aria-label="메뉴 열기"
        class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground"
      >
        <span data-mobile-chevron set:html={chevronDown} />
      </button>
    </div>
  </div>

  <nav
    data-mobile-panel
    hidden
    class="max-h-[calc(100svh-3.5rem)] overflow-y-auto border-b border-sidebar-border bg-sidebar p-2"
  >
    {
      groups.map((group) => {
        const isActive = group.key === active;
        return (
          <div class="flex flex-col gap-1">
            <a
              href={group.href}
              class:list={[
                'flex h-9 items-center justify-between rounded-md px-2 text-sm',
                isActive
                  ? 'bg-sidebar-accent font-medium text-sidebar-accent-foreground'
                  : 'text-sidebar-foreground',
              ]}
            >
              <span>{group.label}</span>
              <span
                class="text-muted-foreground-subtle"
                set:html={isActive ? chevronDown : chevronRight}
              />
            </a>
            {isActive && group.items.length > 0 && (
              <div class="mb-1 ml-3.5 flex flex-col gap-0.5 border-l border-sidebar-border py-0.5 pl-2.5">
                <NavItems
                  items={group.items}
                  idPrefix={`mobile-nav-${group.key}`}
                  activeItem={activeItem}
                />
              </div>
            )}
          </div>
        );
      })
    }
  </nav>
</div>
