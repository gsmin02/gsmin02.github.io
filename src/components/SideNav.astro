---
import { navGroups, type NavKey } from '../lib/nav';
import { chevronDown, chevronRight } from './icons';

interface Props {
  active: NavKey;
  activeItem?: string;
}
const { active, activeItem } = Astro.props;
---

<aside
  data-sidebar-panel
  class="relative hidden shrink-0 border-r border-sidebar-border bg-sidebar md:block"
>
  <div class="sticky top-0 flex h-svh flex-col p-2">
    <div class="flex h-10 items-center px-2">
      <a href="/" class="truncate text-sm font-bold text-sidebar-foreground">gsmin02</a>
    </div>

    <nav class="mt-2 flex flex-col gap-1">
      {
        navGroups.map((group) => {
          const isActive = group.key === active;
          return (
            <div class="flex flex-col gap-1">
              <a
                href={group.href}
                class:list={[
                  'flex h-8 items-center justify-between rounded-md px-2 text-sm transition-colors',
                  isActive
                    ? 'bg-sidebar-accent font-medium text-sidebar-accent-foreground'
                    : 'text-sidebar-foreground hover:bg-sidebar-accent',
                ]}
              >
                <span class="truncate">{group.label}</span>
                <span
                  class="shrink-0 text-muted-foreground-subtle"
                  set:html={isActive ? chevronDown : chevronRight}
                />
              </a>

              {isActive && group.items.length > 0 && (
                <div class="ml-3.5 flex flex-col gap-0.5 border-l border-sidebar-border py-0.5 pl-2.5">
                  {group.items.map((item) => (
                    <a
                      href={item.href}
                      class:list={[
                        'flex h-7 items-center rounded-md px-2 text-sm transition-colors',
                        item.label === activeItem
                          ? 'bg-sidebar-accent font-medium text-sidebar-accent-foreground'
                          : 'text-muted-foreground hover:bg-sidebar-accent',
                      ]}
                    >
                      <span class="truncate">{item.label}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </nav>
  </div>

  <!-- drag to resize, click to close. Hidden on mobile with the whole aside. -->
  <button
    type="button"
    data-sidebar-rail
    aria-label="사이드바 너비 조절"
    title="드래그해 너비 조절 · 클릭해 닫기"
    class="group/rail absolute inset-y-0 -right-1 z-20 w-2 cursor-col-resize touch-none"
  >
    <span
      class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-transparent transition-colors group-hover/rail:bg-ring/60"
    ></span>
  </button>
</aside>
