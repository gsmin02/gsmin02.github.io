---
import type { GetStaticPaths } from 'astro';
import { allCourses } from '../../../lib/quiz';

export const getStaticPaths = (async () =>
  allCourses.map((course) => ({
    params: { course: course.id },
    props: { first: course.chapters[0].slug },
  }))) satisfies GetStaticPaths;

const { course } = Astro.params;
const { first } = Astro.props;
const target = `/quiz/${course}/${first}`;
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>페이지 이동</title>
  </head>
  <body>
    <p>첫 문제로 이동합니다. <a href={target}>직접 이동</a></p>
  </body>
</html>
