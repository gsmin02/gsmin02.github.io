---
import AppShell from '../../layouts/AppShell.astro';
import { courses } from '../../lib/nav';

const total = courses.reduce((a, c) => a + c.total, 0);
---

<AppShell title="퀴즈 · gsmin02" active="quiz" breadcrumb="퀴즈">
  <div class="mx-auto w-full max-w-6xl px-6 py-12 md:py-16">
    <header class="flex flex-col gap-2">
      <h1 class="text-4xl font-bold">무엇을 공부할까요?</h1>
      <p class="text-base text-muted-foreground">
        {courses.length}개 과정 · 총 {total}문항 · 로그인 없이 바로 풀 수 있습니다
      </p>
    </header>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">전체 과정</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          courses.map((course) => (
            <a
              href={`/quiz/${course.id}/${course.chapters[0].slug}`}
              class="flex flex-col gap-4 rounded-md border border-border p-5 transition-colors hover:bg-accent/40"
            >
              <div class="flex flex-col gap-1">
                <span class="text-xs font-medium text-muted-foreground-subtle">{course.category}</span>
                <span class="text-lg font-bold">{course.label}</span>
                <span class="text-sm text-muted-foreground">{course.desc}</span>
              </div>
              <div class="flex items-center justify-between border-t border-border pt-3">
                <span class="text-xs font-medium text-muted-foreground">{course.total}문항</span>
                <span class="text-xs text-muted-foreground-subtle">
                  {course.chapters.length}개 챕터
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</AppShell>
